{
  "_comment": "MixedAudioLink 配置。dims 建议保持 auto（从 net_info 推导）；仅推导失败时手工填写。strict=true 启动校验失败即拒绝（false 仅告警沿用默认值）。",
  "strict": false,
  "models": {
    "asr": {
      "path": "models/qwen3_asr.bmodel",
      "roles": {
        "asr_llm":   "embedding|block_|lm_head|greedy_head",
        "asr_audio": "audio"
      }
    },
    "spk": {
      "path": "models/campplus.bmodel",
      "roles": {
        "speaker": "campplus|speaker"
      }
    },
    "vad": {
      "path": "models/fsmn_vad.bmodel",
      "roles": {
        "vad": "fsmn_vad|speech_fsmn"
      }
    }
  },
  "pcm": {
    "ring_ms": 5000,
    "input_fmt": {"sample_rate": 16000, "channels": 1, "bits": 16}
  },
  "log": {
    "level": 2,
    "file": "",
    "max_bytes": 8388608
  },
  "asr": {
    "enable_history": false,
    "max_new_tokens": 64,
    "language": null,
    "tokens_per_sec": 13,
    "system_prompt": "",
    "mel_bins": 128,
    "mel_filters": "config/mel_filters.npy",
    "vocab": "config/vocab.json",
    "merges": "config/merges.txt"
  },
  "vad": {
    "chunk_ms": 200,
    "speech_padding_ms": 300,
    "min_silence_ms": 500,
    "min_speech_ms": 250,
    "max_seg_s": 30,
    "speech_noise_thres": 0.5,
    "energy_gate": {
      "enable": false,
      "rms_thres": 300,
      "hold_ms": 600
    },
    "ring_ms": 5000,
    "fbank": {
      "num_mel_bins": 80,
      "frame_ms": 25,
      "shift_ms": 10
    }
  },
  "spk": {
    "emb_dim": 192,
    "threshold": 0.6,
    "max_speakers": 8
  },
  "dims": {
    "seq_len": "auto",
    "max_input_length": "auto",
    "audio_length": "auto",
    "hidden_size": "auto",
    "num_layers": "auto"
  }
}
